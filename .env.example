# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get yours free at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── LLM Config ───────────────────────────────────────────────────────────────
# Canonical env var for the LangGraph agent; GEMINI_MODEL kept for back-compat.
# gemini-2.0-flash is confirmed available on the free-tier AI Studio key.
LLM_MODEL=gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── RAG Config ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
PDF_DIR=./data/pdfs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
RETRIEVAL_MODE=hybrid        # vector | hybrid

# ── API Config ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── LangSmith (optional — app runs without these) ────────────────────────────
# Set LANGSMITH_TRACING=true and add your key to enable tracing.
# Get a free key at: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
